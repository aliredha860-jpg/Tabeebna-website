<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Tabeebna</title>
  <meta name="description" content="{{ description or 'Tabeebna is a Bahrain-based student-run nonprofit helping high school students explore career paths through internships, events, and workshops.' }}">

  <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/icons/icon.svg' | url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/img/icons/favicon-32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/img/icons/favicon-16.png' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/img/icons/apple-touch-icon.png' | url }}">
  <link rel="manifest" href="{{ '/site.webmanifest' | url }}">
  <meta name="theme-color" content="#252D41">

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tabeebna">
  <meta property="og:title" content="{{ title }} · Tabeebna">
  <meta property="og:description" content="{{ description or 'Tabeebna is a Bahrain-based student-run nonprofit helping high school students explore career paths through internships, events, and workshops.' }}">
  <meta property="og:image" content="{{ '/assets/img/og-image.png' | url | absoluteUrl(metadata.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} · Tabeebna">
  <meta name="twitter:description" content="{{ description or 'Tabeebna is a Bahrain-based student-run nonprofit helping high school students explore career paths through internships, events, and workshops.' }}">
  <meta name="twitter:image" content="{{ '/assets/img/og-image.png' | url | absoluteUrl(metadata.url) }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Poppins:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="{{ '/' | url }}">
        <img src="{{ '/assets/img/logo.png' | url }}" alt="Tabeebna logo" class="brand__mark">
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
        <span></span><span></span><span></span>
        <span class="sr-only">Menu</span>
      </button>
      <nav id="primary-nav" class="nav">
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        <a href="{{ '/team/' | url }}"{% if page.url == '/team/' %} aria-current="page"{% endif %}>Team</a>
        <a href="{{ '/programs/' | url }}"{% if page.url == '/programs/' %} aria-current="page"{% endif %}>Programs</a>
        <a href="{{ '/apply/' | url }}"{% if page.url == '/apply/' %} aria-current="page"{% endif %}>Apply</a>
        <a href="{{ '/contact/' | url }}"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <div class="site-footer__col">
        <img src="{{ '/assets/img/logo-wide.png' | url }}" alt="Tabeebna logo" class="footer-mark">
        <p>Helping Bahrain's high schoolers find their way into the careers they're curious about.</p>
      </div>
      <div class="site-footer__col">
        <p class="eyebrow">Contact</p>
        <a href="mailto:tabeebnabh@gmail.com" class="icon-link">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5.5h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M2.5 6.5 12 13l9.5-6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>tabeebnabh@gmail.com</span>
        </a>
        <a href="https://instagram.com/tabeebna_bh" target="_blank" rel="noopener" class="icon-link">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
          <span>@tabeebna_bh</span>
        </a>
        <a href="https://tiktok.com/@Tabeebna.bh" target="_blank" rel="noopener" class="icon-link">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3v10.8a3.4 3.4 0 1 1-2.6-3.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 3c.4 2.4 2.1 4.1 4.5 4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Tabeebna.bh</span>
        </a>
      </div>
      <div class="site-footer__col">
        <p class="eyebrow">Explore</p>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/team/' | url }}">Team</a>
        <a href="{{ '/programs/' | url }}">Programs</a>
      </div>
      <div class="site-footer__col">
        <p class="eyebrow">Get involved</p>
        <a href="{{ '/apply/' | url }}">Apply</a>
        <a href="{{ '/contact/' | url }}">Contact us</a>
      </div>
    </div>
    <div class="wrap">
      <p class="fine-print">&copy; {% year %} Tabeebna. Manama, Bahrain.</p>
    </div>
  </footer>

  <script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
